// =============================================================================
// Rental Property Management System - Prisma Schema
// Phase 2, Stage 2 - Final Business Schema
// PostgreSQL 18 | Prisma Client JS | JavaScript ES Modules
// 28 Models | Clean Architecture | Modular Monolith
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// SECTION 1: Identity & Access Management (Tables 1-4)
// =============================================================================

/// Verified system credentials. Decoupled from tenant business profiles.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  phone        String?  @unique @db.VarChar(30)
  passwordHash String   @db.VarChar(255)
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz()
  updatedAt    DateTime @updatedAt @db.Timestamptz()

  // Relations
  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  tenant              Tenant?
  recordedReadings    ElectricityReading[]     @relation("ReadingRecorder")
  verifiedPayments    Payment[]                @relation("PaymentVerifier")
  reviewedSubmissions PaymentSubmission[]      @relation("SubmissionReviewer")
  approvedDeductions  DepositDeduction[]       @relation("DeductionApprover")
  processedRefunds    DepositRefund[]          @relation("RefundProcessor")
  recordedReceipts    SecurityDepositReceipt[] @relation("ReceiptRecorder")
  approvedSettlements MoveOutSettlement[]      @relation("SettlementApprover")
  recordedExpenses    Expense[]                @relation("ExpenseRecorder")
  notifications       Notification[]           @relation("NotificationRecipient")
  auditLogs           AuditLog[]               @relation("AuditActor")

  @@map("users")
}

/// RBAC permission tiers.
model Role {
  id          String   @id @db.VarChar(50)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz()

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

/// Junction table mapping users to roles.
model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.VarChar(50)
  assignedAt DateTime @default(now()) @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// RFC 6749 refresh token rotation with token-family replay detection.
model RefreshToken {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @db.Uuid
  familyId            String    @db.Uuid
  tokenHash           String    @unique @db.VarChar(255)
  generation          Int       @default(1)
  isRevoked           Boolean   @default(false)
  expiresAt           DateTime  @db.Timestamptz()
  revokedAt           DateTime? @db.Timestamptz()
  replacedByTokenHash String?   @db.VarChar(255)
  ipAddress           String?   @db.VarChar(45)
  userAgent           String?   @db.VarChar(255)
  createdAt           DateTime  @default(now()) @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId], name: "idx_refresh_tokens_family")
  @@index([tokenHash, isRevoked], name: "idx_refresh_tokens_lookup")
  @@map("refresh_tokens")
}

// =============================================================================
// SECTION 2: Property & Unit Management (Tables 5-6)
// =============================================================================

/// Physical real estate assets with owner UPI payee configuration.
model Property {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(200)
  addressLine1  String   @db.VarChar(255)
  addressLine2  String?  @db.VarChar(255)
  city          String   @db.VarChar(100)
  stateProvince String   @db.VarChar(100)
  postalCode    String   @db.VarChar(30)
  country       String   @default("India") @db.VarChar(100)
  upiId         String?  @db.VarChar(100)
  upiPayeeName  String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @db.Timestamptz()
  updatedAt     DateTime @updatedAt @db.Timestamptz()

  // Relations
  rentalUnits        RentalUnit[]
  electricityTariffs ElectricityTariff[]
  expenses           Expense[]

  @@map("properties")
}

/// Rentable apartments, rooms, or commercial spaces within a property.
model RentalUnit {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @db.Uuid
  unitNumber      String   @db.VarChar(50)
  floor           Int?
  unitType        String   @db.VarChar(50)
  baseRentAmount  Decimal  @db.Decimal(12, 2)
  occupancyStatus String   @default("VACANT") @db.VarChar(30)
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  // Relations
  property          Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenancyAgreements TenancyAgreement[]
  electricityMeter  ElectricityMeter?

  @@unique([propertyId, unitNumber], name: "uq_property_unit")
  @@map("rental_units")
}

// =============================================================================
// SECTION 3: Tenancy & Occupancy Management (Tables 7-10)
// =============================================================================

/// Tenant personal, employment, and identification data with pre-onboarding lifecycle.
model Tenant {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String?   @unique @db.Uuid
  firstName             String    @db.VarChar(100)
  lastName              String    @db.VarChar(100)
  email                 String    @unique @db.VarChar(255)
  phone                 String    @unique @db.VarChar(30)
  nationalIdNumber      String?   @db.VarChar(100)
  nationalIdType        String?   @db.VarChar(50)
  emergencyContactName  String?   @db.VarChar(150)
  emergencyContactPhone String?   @db.VarChar(30)
  occupation            String?   @db.VarChar(100)
  invitationStatus      String    @default("PENDING") @db.VarChar(30)
  invitationToken       String?   @unique @db.VarChar(255)
  invitationSentAt      DateTime? @db.Timestamptz()
  invitationExpiresAt   DateTime? @db.Timestamptz()
  createdAt             DateTime  @default(now()) @db.Timestamptz()
  updatedAt             DateTime  @updatedAt @db.Timestamptz()

  // Relations
  user                     User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  primaryTenancyAgreements TenancyAgreement[] @relation("PrimaryTenant")
  tenancyMemberships       TenancyMember[]

  @@map("tenants")
}

/// Authoritative lease agreement. primary_tenant_id is the sole source of truth for primary leaseholder.
/// NOTE: The deferrable composite FK (id, primary_tenant_id) -> tenancy_members(tenancy_id, tenant_id)
/// is added via custom SQL migration and cannot be represented natively in Prisma.
model TenancyAgreement {
  id                   String    @id @default(uuid()) @db.Uuid
  agreementNumber      String    @unique @db.VarChar(100)
  rentalUnitId         String    @db.Uuid
  primaryTenantId      String    @db.Uuid
  startDate            DateTime  @db.Date
  endDate              DateTime  @db.Date
  monthlyRentAmount    Decimal   @db.Decimal(12, 2)
  fixedWaterCharge     Decimal   @default(0.00) @db.Decimal(12, 2)
  cautionDepositAmount Decimal   @db.Decimal(12, 2)
  billingCycleDay      Int       @default(1)
  paymentDueDays       Int       @default(10)
  status               String    @default("ACTIVE") @db.VarChar(30)
  terminationDate      DateTime? @db.Date
  createdAt            DateTime  @default(now()) @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @db.Timestamptz()

  // Relations
  rentalUnit         RentalUnit          @relation(fields: [rentalUnitId], references: [id], onDelete: Restrict)
  primaryTenant      Tenant              @relation("PrimaryTenant", fields: [primaryTenantId], references: [id], onDelete: Restrict)
  tenancyMembers     TenancyMember[]
  monthlyBills       MonthlyBill[]
  securityDeposit    SecurityDeposit?
  upiPaymentRequests UpiPaymentRequest[]
  paymentSubmissions PaymentSubmission[]
  payments           Payment[]
  moveOutSettlement  MoveOutSettlement?

  // Partial unique index: uq_unit_single_active_tenancy is implemented via custom SQL migration
  // (CREATE UNIQUE INDEX ... WHERE status = 'ACTIVE')
  @@map("tenancy_agreements")
}

/// Full occupant roster for a tenancy. Enforces composite unique on (tenancy_id, tenant_id).
/// NOTE: The deferrable composite FK on tenancy_agreements(id, primary_tenant_id) referencing
/// (tenancy_id, tenant_id) here is added via custom SQL migration.
model TenancyMember {
  id           String   @id @default(uuid()) @db.Uuid
  tenancyId    String   @db.Uuid
  tenantId     String   @db.Uuid
  relationship String   @db.VarChar(50)
  joinedAt     DateTime @default(now()) @db.Timestamptz()

  // Relations
  tenancyAgreement TenancyAgreement @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenancyId, tenantId], name: "uq_tenancy_member")
  @@map("tenancy_members")
}

/// Final end-of-lease accounting closure and deposit settlement.
model MoveOutSettlement {
  id                        String    @id @default(uuid()) @db.Uuid
  tenancyId                 String    @unique @db.Uuid
  vacatingDate              DateTime  @db.Date
  finalElectricityReadingId String    @db.Uuid
  depositReceivedTotal      Decimal   @db.Decimal(12, 2)
  rentArrearsDeductions     Decimal   @default(0.00) @db.Decimal(12, 2)
  electricityDeductions     Decimal   @default(0.00) @db.Decimal(12, 2)
  waterDeductions           Decimal   @default(0.00) @db.Decimal(12, 2)
  damageDeductions          Decimal   @default(0.00) @db.Decimal(12, 2)
  otherDeductions           Decimal   @default(0.00) @db.Decimal(12, 2)
  totalDeductionsAmount     Decimal   @db.Decimal(12, 2)
  refundPayableAmount       Decimal   @db.Decimal(12, 2)
  actualRefundedAmount      Decimal   @default(0.00) @db.Decimal(12, 2)
  remainingRefundDue        Decimal   @db.Decimal(12, 2)
  settlementStatus          String    @default("DRAFT") @db.VarChar(30)
  settledAt                 DateTime? @db.Timestamptz()
  approvedBy                String    @db.Uuid
  notes                     String?   @db.Text
  createdAt                 DateTime  @default(now()) @db.Timestamptz()
  updatedAt                 DateTime  @updatedAt @db.Timestamptz()

  // Relations
  tenancyAgreement  TenancyAgreement   @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  finalReading      ElectricityReading @relation(fields: [finalElectricityReadingId], references: [id], onDelete: Restrict)
  approver          User               @relation("SettlementApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  depositDeductions DepositDeduction[]
  depositRefunds    DepositRefund[]

  @@map("move_out_settlements")
}

// =============================================================================
// SECTION 4: Utility & Electricity Metering (Tables 11-13)
// =============================================================================

/// Property power tariff using half-open date ranges [effective_from, effective_to).
/// NOTE: Non-overlapping exclusion constraint using btree_gist extension is added via custom SQL migration.
model ElectricityTariff {
  id            String    @id @default(uuid()) @db.Uuid
  propertyId    String    @db.Uuid
  ratePerUnit   Decimal   @db.Decimal(8, 4)
  fixedCharge   Decimal   @default(0.00) @db.Decimal(12, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @db.Timestamptz()

  // Relations
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  electricityReadings ElectricityReading[]

  @@map("electricity_tariffs")
}

/// Physical sub-meter assigned 1:1 to a rental unit.
model ElectricityMeter {
  id               String   @id @default(uuid()) @db.Uuid
  rentalUnitId     String   @unique @db.Uuid
  meterNumber      String   @unique @db.VarChar(100)
  installationDate DateTime @db.Date
  initialReading   Decimal  @default(0.00) @db.Decimal(10, 2)
  status           String   @default("ACTIVE") @db.VarChar(30)
  createdAt        DateTime @default(now()) @db.Timestamptz()
  updatedAt        DateTime @updatedAt @db.Timestamptz()

  // Relations
  rentalUnit          RentalUnit           @relation(fields: [rentalUnitId], references: [id], onDelete: Restrict)
  electricityReadings ElectricityReading[]

  @@map("electricity_meters")
}

/// Monthly physical readings with historical tariff snapshot for reproducible billing.
model ElectricityReading {
  id                   String   @id @default(uuid()) @db.Uuid
  meterId              String   @db.Uuid
  tariffId             String   @db.Uuid
  readingDate          DateTime @db.Date
  readingValue         Decimal  @db.Decimal(10, 2)
  previousReadingValue Decimal  @db.Decimal(10, 2)
  consumptionUnits     Decimal  @db.Decimal(10, 2)
  tariffRateApplied    Decimal  @db.Decimal(8, 4)
  calculatedCharge     Decimal  @db.Decimal(12, 2)
  recordedBy           String   @db.Uuid
  proofImageUrl        String?  @db.VarChar(500)
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz()

  // Relations
  meter             ElectricityMeter    @relation(fields: [meterId], references: [id], onDelete: Restrict)
  tariff            ElectricityTariff   @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  recorder          User                @relation("ReadingRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)
  moveOutSettlement MoveOutSettlement[]

  @@unique([meterId, readingDate], name: "uq_meter_reading_date")
  @@map("electricity_readings")
}

// =============================================================================
// SECTION 5: Recurring Monthly Billing Engine (Tables 14-15)
// =============================================================================

/// Master invoice generated once per tenancy per billing period.
model MonthlyBill {
  id                String   @id @default(uuid()) @db.Uuid
  billNumber        String   @unique @db.VarChar(100)
  tenancyId         String   @db.Uuid
  billingPeriod     String   @db.VarChar(7)
  issueDate         DateTime @db.Date
  dueDate           DateTime @db.Date
  rentAmount        Decimal  @db.Decimal(12, 2)
  waterAmount       Decimal  @db.Decimal(12, 2)
  electricityAmount Decimal  @db.Decimal(12, 2)
  totalAmount       Decimal  @db.Decimal(12, 2)
  paidAmount        Decimal  @default(0.00) @db.Decimal(12, 2)
  balanceAmount     Decimal  @db.Decimal(12, 2)
  status            String   @default("GENERATED") @db.VarChar(30)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz()
  updatedAt         DateTime @updatedAt @db.Timestamptz()

  // Relations
  tenancyAgreement   TenancyAgreement    @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  lineItems          BillLineItem[]
  paymentAllocations PaymentAllocation[]
  depositDeductions  DepositDeduction[]

  @@unique([tenancyId, billingPeriod], name: "uq_tenancy_billing_period")
  @@index([tenancyId, status], name: "idx_monthly_bills_tenancy_status")
  @@index([status, dueDate], name: "idx_monthly_bills_overdue")
  @@map("monthly_bills")
}

/// Itemized bill charges supporting multi-source partial and full settlement.
/// NOTE: Composite FK (bill_id, id) is defined here via @@unique for use as FK target.
/// Composite FKs FROM payment_allocations and deposit_deductions are added via custom SQL migration.
model BillLineItem {
  id                 String   @id @default(uuid()) @db.Uuid
  billId             String   @db.Uuid
  itemType           String   @db.VarChar(50)
  description        String   @db.VarChar(255)
  amount             Decimal  @db.Decimal(12, 2)
  paidAmount         Decimal  @default(0.00) @db.Decimal(12, 2)
  balanceAmount      Decimal  @db.Decimal(12, 2)
  allocationPriority Int
  settlementStatus   String   @default("UNPAID") @db.VarChar(30)
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @db.Timestamptz()
  updatedAt          DateTime @updatedAt @db.Timestamptz()

  // Relations
  bill               MonthlyBill         @relation(fields: [billId], references: [id], onDelete: Restrict)
  paymentAllocations PaymentAllocation[]
  depositDeductions  DepositDeduction[]

  // Composite unique used as FK target for payment_allocations and deposit_deductions
  @@unique([billId, id], name: "uq_bill_line_composite")
  @@index([billId, allocationPriority], name: "idx_bill_line_items_bill_priority")
  @@map("bill_line_items")
}

// =============================================================================
// SECTION 6: Direct UPI Payments, Submissions & UTR Registry (Tables 16-20)
// =============================================================================

/// Server-issued UPI payment context. Prevents client-side tampering with payable amounts.
model UpiPaymentRequest {
  id              String   @id @default(uuid()) @db.Uuid
  tenancyId       String   @db.Uuid
  requestedAmount Decimal  @db.Decimal(12, 2)
  upiReferenceId  String   @unique @db.VarChar(100)
  upiUri          String   @db.Text
  status          String   @default("ACTIVE") @db.VarChar(30)
  expiresAt       DateTime @db.Timestamptz()
  createdAt       DateTime @default(now()) @db.Timestamptz()

  // Relations
  tenancyAgreement   TenancyAgreement    @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  paymentSubmissions PaymentSubmission[]

  @@index([tenancyId, status], name: "idx_upi_requests_tenancy")
  @@map("upi_payment_requests")
}

/// Tenant payment submission pre-verification queue. Never alters outstanding balances.
model PaymentSubmission {
  id                     String    @id @default(uuid()) @db.Uuid
  tenancyId              String    @db.Uuid
  upiRequestId           String?   @db.Uuid
  requestedAmount        Decimal   @db.Decimal(12, 2)
  claimedAmount          Decimal   @db.Decimal(12, 2)
  upiReferenceNumber     String    @db.VarChar(100)
  proofFileUrl           String    @db.VarChar(500)
  proofFileName          String    @db.VarChar(255)
  proofFileSize          Int
  proofMimeType          String    @db.VarChar(100)
  status                 String    @default("PENDING") @db.VarChar(30)
  amountMismatchDetected Boolean   @default(false)
  submittedAt            DateTime  @default(now()) @db.Timestamptz()
  reviewedAt             DateTime? @db.Timestamptz()
  reviewedBy             String?   @db.Uuid
  adminVerifiedAmount    Decimal?  @db.Decimal(12, 2)
  rejectionReason        String?   @db.Text
  notes                  String?   @db.Text
  version                Int       @default(1)
  createdAt              DateTime  @default(now()) @db.Timestamptz()

  // Relations
  tenancyAgreement  TenancyAgreement         @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  upiPaymentRequest UpiPaymentRequest?       @relation(fields: [upiRequestId], references: [id], onDelete: SetNull)
  reviewer          User?                    @relation("SubmissionReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  upiTransactionRef UpiTransactionReference?
  payment           Payment?

  @@index([status, submittedAt(sort: Desc)], name: "idx_payment_submissions_review_queue")
  @@map("payment_submissions")
}

/// Concurrency-proof global UTR registry with engine-level UNIQUE constraint.
/// Prevents duplicate UTR registration under concurrent transactions.
/// NOTE: FK to payments(id) is added via custom SQL migration after payments table is created.
model UpiTransactionReference {
  id           String    @id @default(uuid()) @db.Uuid
  utrNumber    String    @unique @db.VarChar(100)
  submissionId String?   @unique @db.Uuid
  paymentId    String?   @unique @db.Uuid
  status       String    @default("PENDING") @db.VarChar(30)
  registeredAt DateTime  @default(now()) @db.Timestamptz()
  confirmedAt  DateTime? @db.Timestamptz()

  // Relations
  submission PaymentSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  // payment FK added via custom SQL migration (circular dependency)

  @@index([utrNumber, status], name: "idx_upi_registry_lookup")
  @@map("upi_transaction_references")
}

/// Immutable approved financial receipt. Overpayment held in unallocated_advance_amount.
model Payment {
  id                       String   @id @default(uuid()) @db.Uuid
  paymentReference         String   @unique @db.VarChar(100)
  tenancyId                String   @db.Uuid
  submissionId             String?  @unique @db.Uuid
  amount                   Decimal  @db.Decimal(12, 2)
  unallocatedAdvanceAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  paymentMethod            String   @db.VarChar(50)
  upiUtrNumber             String?  @db.VarChar(100)
  isOffline                Boolean  @default(false)
  paymentStatus            String   @default("SUCCESS") @db.VarChar(30)
  paymentDate              DateTime @db.Timestamptz()
  verifiedBy               String   @db.Uuid
  notes                    String?  @db.Text
  createdAt                DateTime @default(now()) @db.Timestamptz()

  // Relations
  tenancyAgreement   TenancyAgreement    @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  submission         PaymentSubmission?  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  verifier           User                @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)
  paymentAllocations PaymentAllocation[]

  // Partial unique index on upi_utr_number WHERE NOT NULL is implemented via custom SQL migration
  @@map("payments")
}

/// Granular FIFO allocation ledger mapping payments to specific bill line items.
/// NOTE: Composite FK (bill_id, line_item_id) -> bill_line_items(bill_id, id) added via custom SQL migration.
model PaymentAllocation {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String   @db.Uuid
  billId          String   @db.Uuid
  lineItemId      String   @db.Uuid
  allocatedAmount Decimal  @db.Decimal(12, 2)
  allocationOrder Int
  createdAt       DateTime @default(now()) @db.Timestamptz()

  // Relations
  payment  Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bill     MonthlyBill  @relation(fields: [billId], references: [id], onDelete: Restrict)
  lineItem BillLineItem @relation(fields: [lineItemId], references: [id], onDelete: Restrict)

  @@index([paymentId], name: "idx_allocations_payment")
  @@index([billId], name: "idx_allocations_bill")
  @@map("payment_allocations")
}

// =============================================================================
// SECTION 7: Security Deposit Escrow (Tables 21-24)
// =============================================================================

/// Dedicated escrow liability account. NOT an advance wallet or rent balance.
/// Intra-row math enforced by chk_deposit_math CHECK constraint via custom SQL migration.
model SecurityDeposit {
  id             String   @id @default(uuid()) @db.Uuid
  tenancyId      String   @unique @db.Uuid
  agreedAmount   Decimal  @db.Decimal(12, 2)
  receivedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  deductedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  refundedAmount Decimal  @default(0.00) @db.Decimal(12, 2)
  currentBalance Decimal  @db.Decimal(12, 2)
  status         String   @default("PENDING") @db.VarChar(30)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  // Relations
  tenancyAgreement TenancyAgreement         @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  receipts         SecurityDepositReceipt[]
  deductions       DepositDeduction[]
  refunds          DepositRefund[]

  @@map("security_deposits")
}

/// Immutable deposit inflow ledger. Each record = one actual payment received.
model SecurityDepositReceipt {
  id                   String   @id @default(uuid()) @db.Uuid
  securityDepositId    String   @db.Uuid
  receiptNumber        String   @unique @db.VarChar(100)
  receivedAmount       Decimal  @db.Decimal(12, 2)
  paymentMethod        String   @db.VarChar(50)
  transactionReference String?  @db.VarChar(100)
  receiptDate          DateTime @db.Date
  recordedBy           String   @db.Uuid
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz()

  // Relations
  securityDeposit SecurityDeposit @relation(fields: [securityDepositId], references: [id], onDelete: Restrict)
  recorder        User            @relation("ReceiptRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([securityDepositId], name: "idx_deposit_receipts_deposit_id")
  @@map("security_deposit_receipts")
}

/// Obligation-linked move-out deductions. Only APPLIED deductions count toward bill-line settlement.
/// NOTE: Composite FK (bill_id, bill_line_item_id) -> bill_line_items(bill_id, id) added via custom SQL migration.
model DepositDeduction {
  id                  String   @id @default(uuid()) @db.Uuid
  securityDepositId   String   @db.Uuid
  moveOutSettlementId String   @db.Uuid
  deductionType       String   @db.VarChar(50)
  deductionAmount     Decimal  @db.Decimal(12, 2)
  billId              String?  @db.Uuid
  billLineItemId      String?  @db.Uuid
  deductionStatus     String   @default("PENDING") @db.VarChar(30)
  reason              String   @db.VarChar(255)
  deductionDate       DateTime @db.Date
  approvedBy          String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz()

  // Relations
  securityDeposit   SecurityDeposit   @relation(fields: [securityDepositId], references: [id], onDelete: Restrict)
  moveOutSettlement MoveOutSettlement @relation(fields: [moveOutSettlementId], references: [id], onDelete: Restrict)
  approver          User              @relation("DeductionApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  bill              MonthlyBill?      @relation(fields: [billId], references: [id], onDelete: Restrict)
  lineItem          BillLineItem?     @relation(fields: [billLineItemId], references: [id], onDelete: Restrict)

  @@index([moveOutSettlementId, deductionStatus], name: "idx_deposit_deductions_settlement")
  @@index([billId], name: "idx_deposit_deductions_bill")
  @@map("deposit_deductions")
}

/// Actual banking/UPI refund disbursement records.
model DepositRefund {
  id                   String   @id @default(uuid()) @db.Uuid
  securityDepositId    String   @db.Uuid
  moveOutSettlementId  String   @db.Uuid
  refundAmount         Decimal  @db.Decimal(12, 2)
  refundMethod         String   @db.VarChar(50)
  transactionReference String   @db.VarChar(100)
  recipientBankDetails String?  @db.Text
  refundDate           DateTime @db.Date
  processedBy          String   @db.Uuid
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz()

  // Relations
  securityDeposit   SecurityDeposit   @relation(fields: [securityDepositId], references: [id], onDelete: Restrict)
  moveOutSettlement MoveOutSettlement @relation(fields: [moveOutSettlementId], references: [id], onDelete: Restrict)
  processor         User              @relation("RefundProcessor", fields: [processedBy], references: [id], onDelete: Restrict)

  @@index([moveOutSettlementId], name: "idx_deposit_refunds_settlement")
  @@map("deposit_refunds")
}

// =============================================================================
// SECTION 8: Operations, Outbox & Audit (Tables 25-28)
// =============================================================================

/// Property expenditure tracking.
model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  propertyId  String   @db.Uuid
  category    String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @db.Date
  vendorName  String?  @db.VarChar(200)
  invoiceUrl  String?  @db.VarChar(500)
  recordedBy  String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz()

  // Relations
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  recorder User     @relation("ExpenseRecorder", fields: [recordedBy], references: [id], onDelete: Restrict)

  @@map("expenses")
}

/// Multi-channel notification delivery.
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @db.Uuid
  title       String    @db.VarChar(255)
  message     String    @db.Text
  type        String    @db.VarChar(50)
  channel     String    @db.VarChar(30)
  isRead      Boolean   @default(false)
  readAt      DateTime? @db.Timestamptz()
  metadata    Json?     @db.JsonB
  createdAt   DateTime  @default(now()) @db.Timestamptz()

  // Relations
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Immutable compliance audit trail.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @db.VarChar(50)
  entityId      String   @db.Uuid
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(255)
  previousState Json?    @db.JsonB
  newState      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @db.Timestamptz()

  // Relations
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)], name: "idx_audit_logs_entity")
  @@map("audit_logs")
}

/// Transactional Outbox for guaranteed at-least-once critical financial event delivery.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @db.VarChar(50)
  aggregateId   String    @db.Uuid
  eventType     String    @db.VarChar(100)
  payload       Json      @db.JsonB
  status        String    @default("PENDING") @db.VarChar(30)
  retryCount    Int       @default(0)
  errorMessage  String?   @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz()
  processedAt   DateTime? @db.Timestamptz()

  @@index([status, createdAt(sort: Asc)], name: "idx_outbox_events_polling")
  @@map("outbox_events")
}
